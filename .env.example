# ----------------------------------------------------------------------------
# Tracking-IDs für Wald & Wiese
#
# Diese Werte nach Anlage der Konten in eine echte .env.local kopieren und
# ausfüllen. Solange leer/ungültig, wird KEIN Tracking-Skript geladen — das
# Consent-Banner funktioniert trotzdem.
#
# GA4 und Google-Ads-Conversion werden als Tags INNERHALB des GTM-Containers
# eingerichtet (in der GTM-Oberfläche) — hier wird nur der Container geladen.
# ----------------------------------------------------------------------------

# Google Tag Manager Container-ID (Format: GTM-XXXXXX)
NEXT_PUBLIC_GTM_ID=

# Hotjar Site-ID (reine Zahl, z. B. 1234567)
NEXT_PUBLIC_HOTJAR_ID=

# ----------------------------------------------------------------------------
# Resend — Kontaktformular (siehe RESEND_SETUP.md für die Schritt-für-Schritt-
# Einrichtung). Server-seitig, deshalb OHNE NEXT_PUBLIC_ Prefix. Solange
# RESEND_API_KEY leer ist, zeigt das Formular einen freundlichen Hinweis mit
# Telefon/E-Mail statt zu versenden.
# ----------------------------------------------------------------------------

# API-Key aus dem Resend-Dashboard (Format: re_xxxxxxxx)
RESEND_API_KEY=

# Verifizierte Absenderadresse (Domain muss in Resend verifiziert sein).
# Format mit Anzeigename: "Wald & Wiese <kontakt@restaurant-waldwiese.de>"
CONTACT_FROM_EMAIL=

# Zielpostfach für Formular-Nachrichten.
# Wenn leer, geht's an info@restaurant-waldwiese.de.
CONTACT_TO_EMAIL=

# ----------------------------------------------------------------------------
# Newsletter (Double-Opt-in + Versand). Nutzt RESEND_API_KEY + CONTACT_FROM_EMAIL
# von oben mit. Kontakte liegen in UNSERER Datenbank (siehe unten), versendet
# wird über Resend. Solange leer, zeigt die Anmeldung einen freundlichen
# Hinweis (Instagram) statt zu senden.
# ----------------------------------------------------------------------------

# Geheimnis zum Signieren der Bestätigungs- UND Abmeldelinks. Lange
# Zufallszeichenkette, z. B. via: openssl rand -base64 32. Nicht mehr ändern.
NEWSLETTER_SECRET=

# ----------------------------------------------------------------------------
# Admin-Backend (/admin) — gemeinsames Passwort fürs Team.
# ----------------------------------------------------------------------------

# Das gemeinsame Login-Passwort.
ADMIN_PASSWORD=

# Geheimnis zum Signieren der Login-Session. Langer Zufallswert,
# z. B. via: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ----------------------------------------------------------------------------
# Datenbank (libSQL). LOKAL leer lassen → es wird automatisch die Datei
# ./.data/wald-wiese.db genutzt. Auf VERCEL eine Turso-DB anlegen
# (siehe BACKEND_SETUP.md) und beide Werte setzen.
# ----------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
