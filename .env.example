# ----------------------------------------------------------------------------
# Tracking-IDs für Wald & Wiese
#
# Diese Werte nach Anlage der Konten in eine echte .env.local kopieren und
# ausfüllen. Solange leer/ungültig, wird KEIN Tracking-Skript geladen — das
# Consent-Banner funktioniert trotzdem.
#
# GA4 und Google-Ads-Conversion werden als Tags INNERHALB des GTM-Containers
# eingerichtet (in der GTM-Oberfläche) — hier wird nur der Container geladen.
# ----------------------------------------------------------------------------

# Google Tag Manager Container-ID (Format: GTM-XXXXXX)
NEXT_PUBLIC_GTM_ID=

# Hotjar Site-ID (reine Zahl, z. B. 1234567)
NEXT_PUBLIC_HOTJAR_ID=
